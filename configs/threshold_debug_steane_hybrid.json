{
  "experiment": {
    "circuit_style": "superdense_color_code_{basis}",
    "basis": "Z",
    "distances": [3],
    "p_values": [0.001],
    "noise_model": "depolarizing",
    "rounds": 3,
    "shots": 64,
    "shots_per_batch": 64,
    "seed": 123,
    "output_dir": "concatbp_outputs/debug_run",
    "resume": false,
    "verbose": true,
    "workers": 1,
    "plot_ler_unit": "per_round"
  },
  "decoder": {
    "colors": ["r", "g", "b"],
    "bp_method": "minimum_sum",
    "schedule": "parallel",
    "lsd_method": "LSD_0",
    "lsd_order": 0,
    "max_iter": 30,
    "ms_scaling_factor": 0.75,
    "relay_bp": {
      "enabled": true,
      "decoder_variant": "f32",
      "gamma0": 0.35,
      "pre_iter": 80,
      "num_sets": 10,
      "set_max_iter": 60,
      "gamma_dist_interval": [-0.35, 0.8],
      "stop_nconv": 1
    },
    "hybrid_two_stage": {
      "enabled": true,
      "stage2_graph_iter_threshold": 140,
      "stage2_graph_decoder": "uf",
      "stage2_graph_non_graphlike_policy": "drop",
      "detailed_stats": true,
      "debug_dump_enabled": true,
      "debug_dump_dir": "concatbp_outputs/hybrid_debug",
      "debug_dump_max_shots": 16
    }
  }
}
