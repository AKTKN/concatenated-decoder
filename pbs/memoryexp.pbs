#!/bin/bash
#PBS -N concatbp_memoryexp
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=12:00:00
#PBS -j oe

set -euo pipefail

# Optional: load modules / activate env
# module load python/3.11
# source /path/to/venv/bin/activate

cd "$PBS_O_WORKDIR"

CONFIG="configs/memory_simulation.json"
SHOTS=""
BATCH=""
WORKERS="8"
QUIET="quiet"

bash scripts/run_memoryexp.sh "$CONFIG" "$SHOTS" "$BATCH" "$WORKERS" "$QUIET"
